managed; //implementation in class zbp_maks_i_xl_user unique;
strict ( 2 );
with draft;

define behavior for ZCJS_I_XL_USER alias XLHead
implementation in class zjs_cl_bp_xl_user unique
persistent table zdjs_excel_user
lock master
total etag LastChangedAt
draft table zdjs_xl_user_dr
early numbering
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;
  field ( readonly ) EndUser, FileId;
  association _XLData { create; with draft; }

  action uploadExcelData result [1] $self;

  determination FillFileStatus on modify { field EndUser; }
  determination FillSelectedStatus on modify { field Attachment; }
  determination autoReadExcel on modify { create;  field Attachment; }

  side effects
  {
    field Attachment affects field FileStatus;
    action uploadExcelData affects $self, messages;
  }

  draft action Activate optimized;
  draft action Edit;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;


  mapping for zdjs_excel_user
    {
      EndUser            = end_user;
      FileId             = file_id;
      FileStatus         = file_status;
      Attachment         = attachment;
      Mimetype           = mimetype;
      Filename           = filename;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

}

define behavior for ZCJS_I_XL_DATA alias XLData
implementation in class zjs_cl_bp_xl_data unique
persistent table zdjs_excel_data
draft table zdjs_xl_data_dr
lock dependent by _XLUser
authorization dependent by _XLUser
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) EndUser, FileId, LineNumber,
  PoNumber, PoItem, GrQuantity, UnitOfMeasure,
  SiteId, HeaderText;
  field ( readonly, numbering : managed ) LineId;

  association _XLUser { with draft; }

  //action uploadXLData result [1] $self;
  action processData result [1] $self;

//  side effects
//  {
//    action uploadXLData affects $self, messages;
//  }

  mapping for zdjs_excel_data
    {
      EndUser       = end_user;
      FileId        = file_id;
      LineId        = line_id;
      LineNumber    = line_no;
      PoNumber      = po_number;
      PoItem        = po_item;
      GrQuantity    = gr_quantity;
      UnitOfMeasure = unit_of_measure;
      SiteId        = site_id;
      HeaderText    = header_text;
    }

}