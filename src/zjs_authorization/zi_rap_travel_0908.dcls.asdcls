@EndUserText.label: 'Access Control for Travel'
@MappingRole: true
define role ZI_RAP_TRAVEL_0908 {
    grant
        select
            on
                ZI_RAP_TRAVEL_0908
                    where
                     ( TravelStatus ) = aspect pfcg_auth( ZOSTAT0908, ZOSTAT0908, ACTVT = '03' ) ; 
                
}