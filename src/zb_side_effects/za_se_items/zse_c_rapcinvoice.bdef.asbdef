projection;
strict ( 2 );   //strict ( 1 );
use draft;

define behavior for ZSE_C_RAPCINVOICE alias Invoice
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Discard;
  use action Activate;
  use action Prepare;
  use action Resume;

  use action createItem;
  use action switchItem;

  use association _Items { create; with draft; }
  use association _Items2 { with draft; }
  use action CreateInvoiceDocument;

  side effects
  {
    field HidePosition1 affects field HidePosition2, field Partner;
    field Partner affects $self;
    action createItem affects entity _Items2, entity _Items;
    action switchItem affects field HidePosition1;
  }

}

define behavior for ZSE_C_RAPCITEMS alias Items
{
  use update;
  use delete;

  use association _Invoice { with draft; }
}

define behavior for ZSE_C_RAPCITEMS2 alias Items2
{
  use update;
  use delete;

  use association _Invoice { with draft; }
}