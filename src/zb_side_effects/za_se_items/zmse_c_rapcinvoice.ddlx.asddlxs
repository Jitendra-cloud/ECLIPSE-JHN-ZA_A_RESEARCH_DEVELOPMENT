@Metadata.layer: #CUSTOMER
//@UI: {
//  headerInfo: {
//    typeName: 'Invoice',
//    typeNamePlural: 'Invoices',
//    title: { value: 'Document' },
//    description: { label: '(Description)' },
//    typeImageUrl: 'sap-icon://my-sales-order'
//  }
//}
annotate entity ZSE_C_RAPCINVOICE with
{

  @UI.facet      : [ { id : 'FacetControlHeader', label : 'Header', type : #FIELDGROUP_REFERENCE, purpose : #HEADER, targetQualifier: 'CONTROL_HEADER' },
                     { id : 'FacetFieldArea', label : 'Information', type : #FIELDGROUP_REFERENCE, purpose : #STANDARD, targetQualifier: 'FIELD_AREA' },
                     { id : 'controlSection', type : #LINEITEM_REFERENCE, position : 30, targetElement: '_Items', hidden: #(HIDEPOSITION2) },
                     { id : 'controlSection2', type : #LINEITEM_REFERENCE, position : 30, targetElement: '_Items2', hidden: #(HIDEPOSITION1) } ]

  @UI            : {
    selectionField : [ { position: 10 } ],
    lineItem     : [ { position: 10 } ]
  }
    @UI.identification: [{ type: #FOR_ACTION, label: 'Create Item Automatic', dataAction: 'createItem', criticality: 'ButtonCriticality' },
                         { type: #FOR_ACTION, label: 'Switch Child Table', dataAction: 'switchItem', criticality: 'ButtonCriticality' } ]
  Document;
  @UI            : {
    lineItem     : [{ position: 20 }],
    fieldGroup   : [{ position: 20, qualifier: 'FIELD_AREA', label: 'Date' }]
  }
  DocDate;
  @UI            : {
    lineItem     : [{ position: 30 }],
    fieldGroup   : [{ position: 30, qualifier: 'FIELD_AREA', label: 'Time' }]
  }
  DocTime;
  @UI            : {
    selectionField : [ { position: 20 } ],
    lineItem     : [{ position: 40 }],
    fieldGroup   : [{ position: 40, qualifier: 'CONTROL_HEADER', label: 'Partner' },
                    { position: 40, qualifier: 'FIELD_AREA', label: 'Partner' }]
  }
  Partner;
  @UI            : {
  lineItem     : [{ position: 50 }]
  }
  NumberOfPositions;

  @UI.fieldGroup   : [{ position: 50, qualifier: 'FIELD_AREA', label: 'Hide Position1' }]
  HidePosition1;

  @UI.fieldGroup   : [{ position: 60, qualifier: 'FIELD_AREA', label: 'Hide Position2' }]
  HidePosition2;

  @UI.hidden: true
  ButtonCriticality;

}